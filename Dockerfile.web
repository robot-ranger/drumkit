FROM nginx:alpine

RUN mkdir -p /usr/share/nginx/html/vendor && \
    wget -q -O /usr/share/nginx/html/vendor/bootstrap.min.css \
        https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css && \
    wget -q -O /usr/share/nginx/html/vendor/bootstrap.bundle.min.js \
        https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js && \
    wget -q -O /usr/share/nginx/html/vendor/mqtt.min.js \
        https://unpkg.com/mqtt/dist/mqtt.min.js

COPY web/index.html /usr/share/nginx/html/index.html
COPY web/style.css  /usr/share/nginx/html/style.css
COPY web/app.js     /usr/share/nginx/html/app.js
